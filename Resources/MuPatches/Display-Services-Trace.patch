+STATIC EFI_STATUS EFIAPI
+UmiTraceLocateProtocol (EFI_GUID *Protocol, VOID *Registration, VOID **Interface)
+{
+  EFI_STATUS Status;
+  UINTN Sequence;
+  BOOLEAN Log;
+  Sequence = ++mUmiTraceSequence;
+  Log = TRUE;
+  if (Log) {
+    DEBUG ((DEBUG_ERROR, "UMI svc %u LocateProtocol enter caller=%p guid=%g\n",
+            (UINT32)Sequence, __builtin_return_address (0), Protocol));
+  }
+  Status = mUmiOriginalBS.LocateProtocol (Protocol, Registration, Interface);
+  if (Log) {
+    DEBUG ((DEBUG_ERROR, "UMI svc %u LocateProtocol exit %r\n", (UINT32)Sequence, Status));
+  }
+  return Status;
+}
