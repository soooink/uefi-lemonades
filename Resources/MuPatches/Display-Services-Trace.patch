+STATIC VOID
+UmiDisplayTraceStart (EFI_GUID *FileName, EFI_HANDLE ImageHandle)
+{
+  EFI_BOOT_SERVICES *BS;
+  EFI_LOADED_IMAGE_PROTOCOL *Image;
+  EFI_STATUS ImageStatus;
+  if (!CompareGuid (FileName, &mUmiDisplayGuid) || mUmiTraceActive) {
+    return;
+  }
+  BS = gDxeCoreST->BootServices;
+  CopyMem (&mUmiOriginalBS, BS, sizeof (mUmiOriginalBS));
+  CopyMem (&mUmiOriginalRT, gDxeCoreRT, sizeof (mUmiOriginalRT));
+  CopyMem (&mUmiOriginalDS, gDxeCoreDS, sizeof (mUmiOriginalDS));
+  mUmiTraceSequence = 0;
+  mUmiStallCount = 0;
+  mUmiDsiPollCount = 0;
+  mUmiDisplayImageBase = 0;
+  Image = NULL;
+  ImageStatus = BS->HandleProtocol (ImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Image);
+  if (!EFI_ERROR (ImageStatus) && (Image != NULL) && (Image->ImageSize >= 0x467D8)) {
+    mUmiDisplayImageBase = (UINTN)Image->ImageBase;
+  }
+  mUmiTraceActive = TRUE;
+  BS->LocateProtocol = UmiTraceLocateProtocol;
+  BS->HandleProtocol = UmiTraceHandleProtocol;
+  BS->LocateHandleBuffer = UmiTraceLocateHandleBuffer;
+  BS->AllocatePool = UmiTraceAllocatePool;
+  BS->FreePool = UmiTraceFreePool;
+  BS->Stall = UmiTraceStall;
+  BS->SignalEvent = UmiTraceSignalEvent;
+  gDxeCoreRT->GetVariable = UmiTraceGetVariable;
+  gDxeCoreRT->SetVariable = UmiTraceSetVariable;
+  gDxeCoreDS->GetMemorySpaceDescriptor = UmiTraceGetMemorySpaceDescriptor;
+  gDxeCoreDS->AddMemorySpace = UmiTraceAddMemorySpace;
+  gDxeCoreDS->SetMemorySpaceAttributes = UmiTraceSetMemorySpaceAttributes;
+  UmiRefreshTableCrc (&BS->Hdr);
+  UmiRefreshTableCrc (&gDxeCoreRT->Hdr);
+  UmiRefreshTableCrc (&gDxeCoreDS->Hdr);
+}
+
+STATIC VOID
+UmiDisplayTraceStop (EFI_GUID *FileName)
+{
+  EFI_BOOT_SERVICES *BS;
+  if (!CompareGuid (FileName, &mUmiDisplayGuid) || !mUmiTraceActive) {
+    return;
+  }
+  BS = gDxeCoreST->BootServices;
+  UmiDsiSnapshot ("display-entry-return");
+  if (BS->LocateProtocol == UmiTraceLocateProtocol) {
+    BS->LocateProtocol = mUmiOriginalBS.LocateProtocol;
+  }
+  if (BS->HandleProtocol == UmiTraceHandleProtocol) {
+    BS->HandleProtocol = mUmiOriginalBS.HandleProtocol;
+  }
+  if (BS->LocateHandleBuffer == UmiTraceLocateHandleBuffer) {
+    BS->LocateHandleBuffer = mUmiOriginalBS.LocateHandleBuffer;
+  }
+  if (BS->AllocatePool == UmiTraceAllocatePool) {
+    BS->AllocatePool = mUmiOriginalBS.AllocatePool;
+  }
+  if (BS->FreePool == UmiTraceFreePool) {
+    BS->FreePool = mUmiOriginalBS.FreePool;
+  }
+  if (BS->Stall == UmiTraceStall) {
+    BS->Stall = mUmiOriginalBS.Stall;
+  }
+  if (BS->SignalEvent == UmiTraceSignalEvent) {
+    BS->SignalEvent = mUmiOriginalBS.SignalEvent;
+  }
+  if (gDxeCoreRT->GetVariable == UmiTraceGetVariable) {
+    gDxeCoreRT->GetVariable = mUmiOriginalRT.GetVariable;
+  }
+  if (gDxeCoreRT->SetVariable == UmiTraceSetVariable) {
+    gDxeCoreRT->SetVariable = mUmiOriginalRT.SetVariable;
+  }
+  if (gDxeCoreDS->GetMemorySpaceDescriptor == UmiTraceGetMemorySpaceDescriptor) {
+    gDxeCoreDS->GetMemorySpaceDescriptor = mUmiOriginalDS.GetMemorySpaceDescriptor;
+  }
+  if (gDxeCoreDS->AddMemorySpace == UmiTraceAddMemorySpace) {
+    gDxeCoreDS->AddMemorySpace = mUmiOriginalDS.AddMemorySpace;
+  }
+  if (gDxeCoreDS->SetMemorySpaceAttributes == UmiTraceSetMemorySpaceAttributes) {
+    gDxeCoreDS->SetMemorySpaceAttributes = mUmiOriginalDS.SetMemorySpaceAttributes;
+  }
+  UmiRefreshTableCrc (&BS->Hdr);
+  UmiRefreshTableCrc (&gDxeCoreRT->Hdr);
+  UmiRefreshTableCrc (&gDxeCoreDS->Hdr);
+  mUmiTraceActive = FALSE;
+}
